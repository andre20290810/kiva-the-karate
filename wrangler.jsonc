// Cloudflare Workers + Static Assets（限定公開）
// 認証ゲート worker/index.js が全リクエストを先に処理する（run_worker_first: true）。
// パスワード・署名鍵は secret で設定し、このファイルや Git には書かない:
//   npx wrangler secret put KIVA_PASSWORD_HASH   （値は node tools/hash-password.mjs の出力）
//   npx wrangler secret put SESSION_SECRET       （32文字以上のランダム文字列）
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kiva-the-karate",
  "main": "worker/public.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none"
  },
  // workers.dev / プレビューURL を無効化（認証の迂回路を作らない。Worker 側でもホスト名を検査）
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "kiva.world-of-andersen.com", "custom_domain": true }
  ],
  "vars": {
    "KIVA_USER": "kiva",
    "ALLOWED_HOST": "kiva.world-of-andersen.com",
    "SESSION_TTL": "43200"
  },
  // ログイン試行のレート制限（IP ごと 60 秒に 10 回）・公式データの保存の試行（IP ごと 60 秒に 10 回）
  "ratelimits": [
    { "name": "LOGIN_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "OFFICIAL_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } }
  ],
  // 公式データ（全利用者に配布する譜面・判定設定・個別エフェクト・公式デモ）の保存先（再デプロイ後も残る）。worker/official.js
  // パスワードは secret OFFICIAL_PASSWORD_HASH（PBKDF2 のハッシュ。node tools/hash-password.mjs で作る）。Git には書かない
  "kv_namespaces": [
    { "binding": "OFFICIAL", "id": "589d41d1eefe4598a3152fc5586e84fd" }
  ],
  "observability": { "enabled": true }
}
